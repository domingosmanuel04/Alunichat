# Platform
PLATFORM_NAME=Alurichat
# production | development
NODE_ENV=development

# Database
DATABASE_URL=mysql://alurichat:alurichat@localhost:3311/alurichat

# Redis
REDIS_URL=redis://localhost:6381

# Auth — in NODE_ENV=production these MUST be unique strong secrets (≥32 chars)
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32!!

# API
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Public web origin (sitemap, robots, llms.txt, roots.txt, emails)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Encryption (AES-256 key material) — required strong value in production
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# Ops / docs
# Swagger: enabled in non-production by default; force with true/false
ENABLE_SWAGGER=true
# Required when NODE_ENV=production for GET /metrics
METRICS_TOKEN=

# Mail (optional)
# MAIL_SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Alurichat <noreply@example.com>"

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=alurichat
S3_FORCE_PATH_STYLE=true

# OpenAI (optional — AI agents / RAG)
# OPENAI_API_KEY=sk-...

# WhatsApp native (Baileys QR sessions)
# Relative to process cwd (apps/api when running the API). Absolute paths also work.
WHATSAPP_SESSIONS_PATH=./data/whatsapp-sessions

# WhatsApp Cloud API (Meta Graph) — used when channel provider = WHATSAPP_CLOUD
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=
