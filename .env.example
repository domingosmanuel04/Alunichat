# Platform
PLATFORM_NAME=Alurichat

# Database
DATABASE_URL=postgresql://alurichat:alurichat@localhost:5437/alurichat?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# Auth
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-min-32!!

# API
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# Encryption (AES-256 key, 32 bytes hex or base64)
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!

# Object storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=alurichat
S3_FORCE_PATH_STYLE=true

# OpenAI (optional — AI agents / RAG)
# OPENAI_API_KEY=sk-...

# WhatsApp native (Baileys QR sessions)
# Relative to process cwd (apps/api when running the API). Absolute paths also work.
WHATSAPP_SESSIONS_PATH=./data/whatsapp-sessions

# WhatsApp (Cloud API / BSP)
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=
