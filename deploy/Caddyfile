# Automatic HTTPS via Let's Encrypt when DOMAIN points to this server.
# Set DOMAIN / ACME_EMAIL in .env.prod (compose passes them to the proxy).

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy web:3000
}

api.{$DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy api:4000
}
