# Copy via: pnpm prod:env seu-dominio.com admin@email.com
# Or: cp .env.prod.example .env.prod && edit secrets

NODE_ENV=production
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# Public URLs (HTTPS via Caddy)
WEB_URL=https://example.com
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_API_URL=https://api.example.com
CORS_ORIGIN=https://example.com

# MySQL (internal Docker network — do not expose ports)
MYSQL_USER=alurichat
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=alurichat
DATABASE_URL=mysql://alurichat:REPLACE_WITH_STRONG_PASSWORD@mysql:3306/alurichat

# Redis
REDIS_URL=redis://redis:6379

# Auth / crypto (≥32 chars, unique per environment)
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_SECRET
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_SECRET

# Ops
API_PORT=4000
ENABLE_SWAGGER=false
METRICS_TOKEN=REPLACE_WITH_METRICS_TOKEN
PLATFORM_NAME=Alurichat

# First Super Admin (used by bootstrap only)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD_MIN_12
BOOTSTRAP_ADMIN_NAME=Super Admin

# Mail (recommended in production)
MAIL_FROM="Alurichat <noreply@example.com>"
MAIL_SMTP_URL=

# WhatsApp Cloud (optional)
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_SESSIONS_PATH=/app/apps/api/data/whatsapp-sessions
